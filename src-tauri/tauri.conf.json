{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Renpy Node Editor",
  "version": "0.3.0",
  "identifier": "com.renpynodeeditor.app",
  "build": {
    "beforeDevCommand": "node scripts/build-web.js",
    "beforeBuildCommand": "node scripts/build-web.js",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Ren'Py Node Editor", "width": 1440, "height": 880, "minWidth": 900, "minHeight": 600 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Visual node editor for Ren'Py",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
